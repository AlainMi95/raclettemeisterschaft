---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import NextEvent from '../../components/home/NextEvent.astro';
import LatestNews from '../../components/home/LatestNews.astro';
import Teaser from '../../components/home/Teaser.astro';
import { getPath, langs, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang).home;
---

<BaseLayout lang={lang} route="home">
  <Hero lang={lang} />
  <NextEvent lang={lang} />
  <section class="section">
    <div class="container">
      <Teaser
        eyebrow={t.about.eyebrow}
        heading={t.about.heading}
        text={t.about.text}
        linkLabel={t.about.cta}
        href={getPath(lang, 'about')}
      />
    </div>
  </section>
  <LatestNews lang={lang} />
  <section class="section">
    <div class="container panels">
      <Teaser
        variant="panel"
        eyebrow={t.rules.eyebrow}
        heading={t.rules.heading}
        text={t.rules.text}
        linkLabel={t.rules.cta}
        href={getPath(lang, 'rules')}
      />
      <Teaser
        variant="panel"
        eyebrow={t.pastWinners.eyebrow}
        heading={t.pastWinners.heading}
        text={t.pastWinners.text}
        linkLabel={t.pastWinners.cta}
        href={getPath(lang, 'pastWinners')}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .panels {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .panels {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
  }
</style>
