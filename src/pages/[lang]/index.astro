---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langs, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="home">
  <h1 class="visually-hidden">{t.site.name}</h1>
  <div class="flyer">
    <!-- The flyer matching the page's random color scheme (set in BaseLayout) -->
    <img
      id="flyer"
      alt={t.home.flyerAlt}
      width="1132"
      height="1600"
      fetchpriority="high"
      decoding="async"
    />
    <script is:inline>
      document.getElementById('flyer').src =
        `/images/flyer-${document.documentElement.dataset.flyer || 'orange'}.jpg`;
    </script>
    <noscript>
      <img
        src="/images/flyer-orange.jpg"
        alt={t.home.flyerAlt}
        width="1132"
        height="1600"
      />
    </noscript>
  </div>
</BaseLayout>

<style>
  .flyer {
    padding: 0.25rem 0.75rem 1rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  /* Without JavaScript the empty scripted <img> stays hidden; the <noscript> one shows instead */
  img:not([src]) {
    display: none;
  }

  /* Desktop: fit the whole poster into the viewport, never upscale past its native width */
  @media (min-width: 48rem) {
    .flyer {
      padding: clamp(1rem, 4vh, 3rem) var(--gutter) clamp(3rem, 8vh, 6rem);
    }

    img {
      width: clamp(24rem, calc((100svh - 10rem) * 1132 / 1600), 70.75rem);
      max-width: 100%;
    }
  }
</style>
