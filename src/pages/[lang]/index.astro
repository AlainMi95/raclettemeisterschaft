---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { langs, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} route="home">
  <h1 class="visually-hidden">{t.site.name}</h1>
  <div class="flyer">
    <img
      src="/images/flyer.jpg"
      alt={t.home.flyerAlt}
      width="904"
      height="1280"
      fetchpriority="high"
      decoding="async"
    />
  </div>
</BaseLayout>

<style>
  .flyer {
    padding: 0.25rem 0.75rem 1rem;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  /* Desktop: fit the whole poster into the viewport, never upscale past its native width */
  @media (min-width: 48rem) {
    .flyer {
      padding: clamp(1rem, 4vh, 3rem) var(--gutter) clamp(3rem, 8vh, 6rem);
    }

    img {
      width: clamp(24rem, calc((100svh - 10rem) * 904 / 1280), 56.5rem);
      max-width: 100%;
    }
  }
</style>
