---
import HeroIllustration from './HeroIllustration.astro';
import { getPath, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).home.hero;

// Set to e.g. { src: '/images/hero.jpg', alt: '...' } once a photo exists (put it in /public/images).
const heroImage = null as { src: string; alt: string } | null;
---

<section class="hero">
  <div class="container grid">
    <div class="content">
      <span class="eyebrow">{t.eyebrow}</span>
      <h1>{t.title}</h1>
      <p class="lead">{t.intro}</p>
      <div class="actions">
        <a class="button button--primary" href={getPath(lang, 'about')}>{t.primaryCta}</a>
        <a class="button button--secondary" href={getPath(lang, 'news')}>{t.secondaryCta}</a>
      </div>
      <p class="next">
        <span class="next-label">{t.nextEventLabel}</span>
        <span>{t.nextEventValue}</span>
      </p>
    </div>
    <div class="visual">
      {heroImage ? <img src={heroImage.src} alt={heroImage.alt} /> : <HeroIllustration />}
    </div>
  </div>
</section>

<style>
  .hero {
    padding: clamp(2rem, 6vw, 5rem) 0 var(--section-space);
  }

  .grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  h1 {
    margin-bottom: 1.25rem;
    /* sized so the longest word ("Meisterschaft", ~7.5em) fits its column */
    font-size: clamp(2.5rem, 11vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    hyphens: auto;
  }

  @media (min-width: 60rem) {
    h1 {
      margin-bottom: 1.75rem;
      font-size: clamp(3rem, 5.4vw, 4.75rem);
    }

    .content h1::after {
      margin-top: 1.5rem;
    }
  }

  /* Accent bar under the headline */
  h1::after {
    content: '';
    display: block;
    width: 5rem;
    height: 0.5rem;
    margin-top: 1rem;
    background: var(--color-accent);
  }

  .lead {
    max-width: 34rem;
    margin-bottom: 1.75rem;
  }

  /* Stacked full-width buttons on phones */
  .actions {
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 30rem) {
    .actions {
      display: flex;
      flex-wrap: wrap;
    }

    .lead {
      margin-bottom: 2.25rem;
    }
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .next-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .visual {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-dark);
    border-radius: 0.25rem;
  }

  @media (min-width: 60rem) {
    .visual {
      aspect-ratio: 4 / 5;
    }
  }

  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 59.99rem) {
    .visual :global(svg) {
      width: 45%;
    }
  }
</style>
