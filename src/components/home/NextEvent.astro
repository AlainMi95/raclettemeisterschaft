---
import { getPath, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).home.nextEvent;

// Replace with real values once known; `null` shows the "to be announced" text.
const event: { date: string | null; location: string | null } = {
  date: null,
  location: null,
};

const details = [
  { label: t.dateLabel, value: event.date },
  { label: t.locationLabel, value: event.location },
];
---

<section class="section section--dark">
  <div class="container grid">
    <div class="intro">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.heading}</h2>
    </div>
    <dl class="details">
      {
        details.map(({ label, value }) => (
          <div class="row">
            <dt>{label}</dt>
            <dd class:list={{ tbd: !value }}>{value ?? t.tbd}</dd>
          </div>
        ))
      }
    </dl>
    <div class="more">
      <p class="note">{t.note}</p>
      <a class="link-arrow" href={getPath(lang, 'news')}>{t.cta}</a>
    </div>
  </div>
</section>

<style>
  /* Mobile: heading → details → note. Desktop: heading + note left, details right. */
  .grid {
    display: grid;
    grid-template-areas:
      'intro'
      'details'
      'more';
    gap: 2rem;
  }

  .intro {
    grid-area: intro;
  }

  .details {
    grid-area: details;
  }

  .more {
    grid-area: more;
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'intro details'
        'more details';
      grid-template-rows: auto 1fr;
      gap: 1.5rem 5rem;
      align-items: start;
    }

    .details {
      align-self: center;
    }
  }

  h2 {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
  }

  .note {
    margin-bottom: 1.5rem;
    color: var(--color-on-dark-muted);
  }

  .link-arrow {
    color: var(--color-on-dark);
  }

  dl {
    margin: 0;
  }

  .row {
    padding: 1.125rem 0;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .row:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }

  dt {
    margin-bottom: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  dd {
    margin: 0;
    font-size: clamp(1.375rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  dd.tbd {
    font-weight: 600;
    color: var(--color-on-dark);
  }

  @media (min-width: 60rem) {
    .row {
      padding: 1.5rem 0;
    }

    dt {
      margin-bottom: 0.375rem;
    }

    dd.tbd {
      color: var(--color-on-dark-muted);
    }
  }
</style>
