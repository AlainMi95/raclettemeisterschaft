---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { preamble, sections } = useTranslations(lang).rules;
---

<section class="block">
  <h2>{preamble.title}</h2>
  <div class="prose">
    {preamble.paragraphs.map((text) => <p>{text}</p>)}
  </div>
</section>

{
  sections.map((section, index) => (
    <section class="block">
      <h2>
        <span class="number">{index + 1}.</span> {section.title}
      </h2>
      <div class="prose">
        {section.paragraphs.map((text) => <p>{text}</p>)}
      </div>
      {section.items && (
        <ol type="a" class="items">
          {section.items.map((item) => <li>{item}</li>)}
        </ol>
      )}
      {section.statement && (
        <figure class="statement">
          <figcaption>{section.statement.author}</figcaption>
          <blockquote>
            <p>{section.statement.text}</p>
          </blockquote>
        </figure>
      )}
    </section>
  ))
}

<style>
  .block + .block {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.5rem, 3.5vw, 2.125rem);
  }

  .number {
    font-variant-numeric: tabular-nums;
  }

  .prose p + p {
    margin-top: 1em;
  }

  .items {
    max-width: 62ch;
    margin: 1rem 0 0;
    padding-left: 1.75rem;
  }

  .items li {
    padding-left: 0.375rem;
  }

  .items li + li {
    margin-top: 0.5rem;
  }

  .items li::marker {
    font-weight: 700;
  }

  .statement {
    max-width: 62ch;
    margin: 2rem 0 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 4px solid var(--color-text);
  }

  .statement figcaption {
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .statement blockquote {
    margin: 0;
    font-weight: 300;
  }
</style>
