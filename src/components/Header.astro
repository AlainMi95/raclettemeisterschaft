---
import { getPath, languages, langs, navRoutes, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);

const navItems = navRoutes.map((navRoute) => ({
  href: getPath(lang, navRoute),
  label: t.nav[navRoute],
  current: navRoute === route,
}));
---

<header class="site-header">
  <div class="bar">
    {route !== 'home' && <a href={getPath(lang)} class="brand">{t.site.name}</a>}

    <ul class="lang-toggle" aria-label={t.a11y.languageToggle}>
      {
        langs.map((l) => (
          <li>
            <a
              href={getPath(l, route)}
              hreflang={l}
              lang={l}
              title={languages[l]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Menu (no JavaScript: native <details> toggle) -->
    <details class="menu">
      <summary aria-label={t.a11y.menu}>
        <span class="menu-label" aria-hidden="true">{t.a11y.menu}</span>
        <span class="icon" aria-hidden="true"></span>
      </summary>
      <nav aria-label={t.a11y.mainNav}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.875rem var(--gutter);
  }

  .brand {
    margin-right: auto;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Language switch: DE / EN */
  .lang-toggle {
    gap: 0.125rem;
  }

  .lang-toggle a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .lang-toggle a:hover,
  .lang-toggle a[aria-current] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  /* Menu control */
  .menu summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 2.5rem;
    padding: 0 0.5rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-label {
    display: none;
  }

  /* Hamburger icon, turns into a cross when open */
  .icon,
  .icon::before,
  .icon::after {
    display: block;
    width: 1.375rem;
    height: 2px;
    background: currentColor;
  }

  .icon {
    position: relative;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .icon::before {
    top: -7px;
  }

  .icon::after {
    top: 7px;
  }

  .menu[open] .icon {
    background: transparent;
  }

  .menu[open] .icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu[open] .icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 2px solid var(--color-text);
  }

  .menu nav ul {
    flex-direction: column;
    padding: 0.25rem var(--gutter) 1rem;
  }

  .menu nav a {
    display: block;
    padding: 0.625rem 0;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .menu nav a:hover,
  .menu nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 48rem) {
    .bar {
      gap: 1.5rem;
      padding-top: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .brand {
      font-size: 1.25rem;
    }

    .menu {
      position: relative;
    }

    .menu-label {
      display: inline;
    }

    /* Dropdown anchored under the menu control */
    .menu nav {
      left: auto;
      right: 0;
      min-width: 16rem;
      margin-top: 0.5rem;
      border: 2px solid var(--color-text);
    }

    .menu nav ul {
      padding: 0.75rem 1.25rem;
    }

    .menu nav a {
      padding: 0.375rem 0;
      font-size: 1.25rem;
      white-space: nowrap;
    }
  }
</style>
