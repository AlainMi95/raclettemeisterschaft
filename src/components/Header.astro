---
import BrandMark from './BrandMark.astro';
import { getPath, languages, langs, navRoutes, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);

const navItems = navRoutes.map((navRoute) => ({
  href: getPath(lang, navRoute),
  label: t.nav[navRoute],
  current: navRoute === route,
}));
---

<header class="site-header">
  <div class="container bar">
    <a href={getPath(lang)} class="brand">
      <BrandMark size={36} />
      <span>{t.site.name}</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="nav-desktop" aria-label={t.a11y.mainNav}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ul class="lang-toggle" aria-label={t.a11y.languageToggle}>
      {
        langs.map((l) => (
          <li>
            <a
              href={getPath(l, route)}
              hreflang={l}
              lang={l}
              title={languages[l]}
              aria-current={l === lang ? 'true' : undefined}
            >
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile navigation (no JavaScript: native <details> toggle) -->
    <details class="nav-mobile">
      <summary aria-label={t.a11y.menu}>
        <span class="icon" aria-hidden="true"></span>
      </summary>
      <nav aria-label={t.a11y.mainNav}>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--color-border);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  /* Two-line brand lockup on small screens */
  .brand span {
    width: min-content;
  }

  .brand :global(svg) {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: block;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: var(--color-muted);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  /* Desktop nav */
  .nav-desktop {
    display: none;
  }

  .nav-desktop ul {
    gap: 2rem;
  }

  .nav-desktop a {
    padding: 0.375rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-desktop a[aria-current='page'] {
    border-bottom-color: var(--color-accent);
  }

  /* Mobile menu */
  .nav-mobile summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px solid var(--color-text);
    border-radius: 0.25rem;
    cursor: pointer;
    list-style: none;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  /* Hamburger icon, turns into a cross when open */
  .icon,
  .icon::before,
  .icon::after {
    display: block;
    width: 1.125rem;
    height: 2px;
    background: var(--color-text);
  }

  .icon {
    position: relative;
  }

  .icon::before,
  .icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .icon::before {
    top: -6px;
  }

  .icon::after {
    top: 6px;
  }

  .nav-mobile[open] .icon {
    background: transparent;
  }

  .nav-mobile[open] .icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-mobile[open] .icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-mobile nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav-mobile ul {
    flex-direction: column;
    padding: 0.5rem var(--gutter) 1rem;
  }

  .nav-mobile a {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 1.125rem;
  }

  .nav-mobile li:last-child a {
    border-bottom: 0;
  }

  .nav-mobile a[aria-current='page'] {
    box-shadow: inset 4px 0 0 var(--color-accent);
    padding-left: 0.875rem;
  }

  @media (min-width: 60rem) {
    .bar {
      gap: 2rem;
      padding-top: 1.125rem;
      padding-bottom: 1.125rem;
    }

    .brand {
      gap: 0.625rem;
      font-size: 1.375rem;
    }

    .brand span {
      width: auto;
    }

    .brand :global(svg) {
      width: 2.25rem;
      height: 2.25rem;
    }

    .nav-desktop {
      display: block;
    }

    .nav-mobile {
      display: none;
    }
  }

  /* Language switch: DE | EN */
  .lang-toggle {
    border: 2px solid var(--color-text);
    border-radius: 0.25rem;
    overflow: hidden;
  }

  .lang-toggle a {
    display: grid;
    place-items: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .lang-toggle a:hover {
    background: var(--color-surface);
  }

  .lang-toggle a[aria-current] {
    background: var(--color-text);
    color: var(--color-bg);
  }

  @media (min-width: 60rem) {
    .lang-toggle a {
      height: auto;
      padding: 0.25rem 0.625rem;
    }
  }
</style>
