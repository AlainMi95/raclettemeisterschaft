---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { story, team } = useTranslations(lang).about;
---

<section class="block">
  <h2>{story.title}</h2>
  <div class="prose">
    {story.paragraphs.map((text) => <p>{text}</p>)}
  </div>
</section>

<section class="block">
  <h2>{team.title}</h2>
  <div class="prose">
    {team.paragraphs.map((text) => <p>{text}</p>)}
  </div>

  <!-- Replace with the team photo once it is available -->
  <div class="photo-placeholder">{team.photoPlaceholder}</div>

  <h3>{team.membersTitle}</h3>
  <ul class="members">
    {
      team.members.map((member) => (
        <li>
          <strong>{member.name}</strong> – {member.role}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .block + .block {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
  }

  h3 {
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .prose p + p {
    margin-top: 1em;
  }

  .photo-placeholder {
    display: grid;
    place-items: center;
    max-width: 62ch;
    aspect-ratio: 3 / 2;
    margin: 2.5rem 0;
    border: 2px dashed var(--color-text);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .members {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .members li {
    max-width: 62ch;
    padding: 0.5rem 0;
    border-top: 2px solid var(--color-text);
  }

  .members li:last-child {
    border-bottom: 2px solid var(--color-text);
  }
</style>
