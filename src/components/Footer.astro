---
import BrandMark from './BrandMark.astro';
import { getPath, languages, langs, navRoutes, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand-block">
        <a href={getPath(lang)} class="brand">
          <BrandMark size={44} />
          <span>{t.site.name}</span>
        </a>
        <p class="description">{t.footer.description}</p>
      </div>
      <nav aria-label={t.footer.pagesHeading}>
        <h2>{t.footer.pagesHeading}</h2>
        <ul>
          {
            navRoutes.map((navRoute) => (
              <li>
                <a href={getPath(lang, navRoute)}>{t.nav[navRoute]}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div>
        <h2>{t.footer.languageHeading}</h2>
        <ul>
          {
            langs.map((l) => (
              <li>
                <a
                  href={getPath(l, route)}
                  hreflang={l}
                  lang={l}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {languages[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <p class="copyright">&copy; {year} {t.footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 1.5rem;
    background: var(--color-dark);
    color: var(--color-on-dark);
    border-top: 0.5rem solid var(--color-accent);
  }

  /* Mobile: brand full width, pages + language side by side */
  .top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 1.5rem;
    padding-bottom: 2rem;
  }

  .brand-block {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .top {
      grid-template-columns: 2fr 1fr 1fr;
      gap: 2.5rem;
      padding-bottom: 3rem;
    }

    .brand-block {
      grid-column: auto;
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: clamp(1.375rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }

  .brand :global(svg) {
    width: clamp(2rem, 4vw, 2.75rem);
    height: clamp(2rem, 4vw, 2.75rem);
    flex-shrink: 0;
  }

  .description {
    margin-top: 0.75rem;
    color: var(--color-on-dark-muted);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-dark-muted);
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    text-decoration: none;
  }

  ul a:hover,
  ul a[aria-current] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .copyright {
    max-width: none;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    font-size: 0.875rem;
    color: var(--color-on-dark-muted);
  }
</style>
