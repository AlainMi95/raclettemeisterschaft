---
import { twitchUrl, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang).livestream;
---

<p class="lead">{t.text}</p>

<a class="button" href={twitchUrl} target="_blank" rel="noopener">
  {t.link} →
</a>

<style>
  .lead {
    max-width: 62ch;
  }

  .button {
    display: inline-block;
    margin-top: 1.5rem;
    padding: 0.875rem 1.5rem;
    font-weight: 700;
    color: var(--color-bg);
    background: var(--color-text);
    text-decoration: none;
  }

  .button:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
