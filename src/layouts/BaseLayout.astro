---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { flyerColors, useTranslations, type Lang, type RouteKey } from '../i18n';
import '@fontsource/mali/latin-300.css';
import '@fontsource/mali/latin-400.css';
import '@fontsource/mali/latin-700.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  route: RouteKey;
  /** Page title; the site name is appended. Omit on the homepage. */
  title?: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${t.site.name}` : t.site.name;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? t.site.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <!-- Browser bar tint (Safari, Chrome on Android); updated by the script below -->
    <meta name="theme-color" content={flyerColors.orange} />
    <!--
      Random flyer color scheme per page load (never the same twice in a row).
      Pink only on the home page: its green text is too hard to read in longer texts.
      Runs before the page is drawn, so there is no flash of the default orange.
      Also sets theme-color, otherwise Safari keeps tinting its bar in the previous page's color.
    -->
    <script is:inline define:vars={{ flyerColors, isHome: route === 'home' }}>
      let last = null;
      try {
        last = sessionStorage.getItem('flyer');
      } catch {}
      const options = Object.keys(flyerColors).filter(
        (color) => color !== last && (isHome || color !== 'pink'),
      );
      const flyer = options[Math.floor(Math.random() * options.length)];
      document.documentElement.dataset.flyer = flyer;
      document.querySelector('meta[name="theme-color"]').content = flyerColors[flyer];
      try {
        sessionStorage.setItem('flyer', flyer);
      } catch {}
    </script>
  </head>
  <body>
    <Header lang={lang} route={route} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
